/**
 * Every cover the generator can draw. A slug in two modules is a mistake, and
 * the later spread would win silently, so the generator checks for it.
 */
export const SCENES: Record<string, Scene> = {
  ...CORE_SCENES,
  ...MATTEUS_SCENES,
  ...LUCAS_SCENES,
  ...JOHANNES_SCENES,
  ...ROMEINEN_SCENES,
  ...KORINTHE1_SCENES,
  ...KORINTHE2_SCENES,
  ...GALATEN_SCENES,
  ...KOLOSSENZEN_SCENES,
  ...THESS1_SCENES,
  ...THESS2_SCENES,
  ...EFEZE_SCENES,
  ...FILIPPENZEN_SCENES,
  ...TIM1_SCENES,
  ...TIM2_SCENES,
  ...TITUS_SCENES,
  ...FILEMON_SCENES,
  ...HEBREEEN_SCENES,
};

export const SCENE_MODULES: Record<string, Record<string, Scene>> = {
  core: CORE_SCENES,
  matteus: MATTEUS_SCENES,
  lucas: LUCAS_SCENES,
  johannes: JOHANNES_SCENES,
  romeinen: ROMEINEN_SCENES,
  '1-korinthe': KORINTHE1_SCENES,
  '2-korinthe': KORINTHE2_SCENES,
  galaten: GALATEN_SCENES,
  kolossenzen: KOLOSSENZEN_SCENES,
  '1-thessalonicenzen': THESS1_SCENES,
  '2-thessalonicenzen': THESS2_SCENES,
  efeze: EFEZE_SCENES,
  filippenzen: FILIPPENZEN_SCENES,
  '1-timotheus': TIM1_SCENES,
  '2-timotheus': TIM2_SCENES,
  titus: TITUS_SCENES,
  filemon: FILEMON_SCENES,
  hebreeen: HEBREEEN_SCENES,
};

export function renderScene(slug: string): string {
  const scene = SCENES[slug];
  if (!scene) throw new Error(`No scene defined for "${slug}"`);
  return renderSceneFor(slug, scene);
}
