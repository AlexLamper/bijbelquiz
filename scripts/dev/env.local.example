# Local development values. Copied to .env.local by `npm run dev:setup`.
# Nothing in here is a real secret; production values live in Vercel.

# Local MongoDB started by scripts/dev/mongod.sh
MONGODB_URI=mongodb://127.0.0.1:27027/bijbelquiz-dev

# next-auth (any long random string works locally)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
JWT_SECRET=local-dev-jwt-secret-0123456789abcdef

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@bijbelquiz.com
NEXT_PUBLIC_BUG_REPORT_EMAIL=support@bijbelquiz.com

# Social login is off locally unless you add real client ids.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Stripe: use test-mode keys from your own Stripe account, or leave empty
# (the premium checkout then reports that payments are not configured).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TRIAL_DAYS=7

# Mail is not sent locally; the contact form logs instead when SMTP is empty.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=

# Google Play badge appears once the Android app is published.
# NEXT_PUBLIC_GOOGLE_PLAY_URL=
